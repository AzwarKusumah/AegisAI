[Unit]
Description=AegisAI Next.js audit dashboard
Wants=network-online.target aegisai-control-plane.service
After=network-online.target aegisai-control-plane.service

[Service]
Type=simple
User=aegisai
Group=aegisai
WorkingDirectory=/opt/aegisai/dashboard
EnvironmentFile=/etc/aegisai/aegisai.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/env node /opt/aegisai/dashboard/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
ReadWritePaths=/opt/aegisai/dashboard/.next/cache
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
