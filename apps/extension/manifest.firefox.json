{
  "manifest_version": 2,
  "name": "AegisAI Protection",
  "version": "0.4.0",
  "description": "Opt-in local inspection of selected files on supported AI-provider pages.",
  "permissions": [
    "nativeMessaging", "storage",
    "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*", "https://perplexity.ai/*", "https://grok.com/*"
  ],
  "browser_action": { "default_popup": "popup.html" },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*",
      "https://copilot.microsoft.com/*", "https://perplexity.ai/*", "https://grok.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "browser_specific_settings": {
    "gecko": { "id": "aegisai@example.invalid" }
  }
}
