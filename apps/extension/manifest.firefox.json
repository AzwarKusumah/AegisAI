{
  "manifest_version": 2,
  "name": "AegisAI Protection",
  "version": "0.2.0",
  "description": "Observe AI attachment selections and send metadata to the local AegisAI agent.",
  "permissions": [
    "nativeMessaging", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*", "https://perplexity.ai/*", "https://grok.com/*"
  ],
  "background": { "scripts": ["dist/background.js"] },
  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*",
      "https://copilot.microsoft.com/*", "https://perplexity.ai/*", "https://grok.com/*"
    ],
    "js": ["dist/content.js"], "run_at": "document_start"
  }],
  "browser_specific_settings": { "gecko": { "id": "aegisai@example.invalid" } }
}
