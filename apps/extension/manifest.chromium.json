{
  "manifest_version": 3,
  "name": "AegisAI Protection",
  "version": "0.3.0",
  "description": "Opt-in local inspection of selected files on supported AI-provider pages.",
  "permissions": ["nativeMessaging", "storage"],
  "action": { "default_popup": "popup.html" },
  "host_permissions": [
    "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*", "https://perplexity.ai/*", "https://grok.com/*"
  ],
  "background": { "service_worker": "dist/background.js" },
  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*",
      "https://copilot.microsoft.com/*", "https://perplexity.ai/*", "https://grok.com/*"
    ],
    "js": ["dist/content.js"],
    "run_at": "document_start"
  }]
}
