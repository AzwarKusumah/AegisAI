POSTGRES_DB=aegisai
POSTGRES_USER=aegisai
POSTGRES_PASSWORD=generate-a-random-hex-secret
DATABASE_URL=postgres://aegisai:generate-a-random-hex-secret@127.0.0.1:5432/aegisai?sslmode=disable
AEGIS_AGENT_TOKEN=generate-a-random-agent-token
AEGIS_ADMIN_TOKEN=generate-a-random-admin-token
AEGIS_LISTEN_ADDR=127.0.0.1:8787
AEGIS_API_URL=http://127.0.0.1:8787

# Dashboard credentials (server-side only; never use NEXT_PUBLIC_).
AEGIS_DASHBOARD_USER=admin
AEGIS_DASHBOARD_PASSWORD=generate-a-long-random-dashboard-password
AEGIS_DASHBOARD_PORT=3000

# Endpoint agent-local settings. Configure on each endpoint.
AEGIS_PYTHON=python
AEGIS_ENGINE_PATH=/absolute/path/to/AegisAI/engine
AEGIS_EXTENSION_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID/
