POSTGRES_DB=aegisai
POSTGRES_USER=aegisai
POSTGRES_PASSWORD=change-this-local-development-password
DATABASE_URL=postgres://aegisai:change-this-local-development-password@127.0.0.1:5432/aegisai?sslmode=disable
AEGIS_AGENT_TOKEN=replace-with-random-agent-token
AEGIS_ADMIN_TOKEN=replace-with-random-admin-token
AEGIS_LISTEN_ADDR=127.0.0.1:8787
AEGIS_API_URL=http://127.0.0.1:8787

# Dashboard credentials (server-side only; do not prefix with NEXT_PUBLIC_)
AEGIS_DASHBOARD_USER=admin
AEGIS_DASHBOARD_PASSWORD=replace-with-a-long-random-dashboard-password

# Endpoint agent-local settings. Configure on each endpoint.
AEGIS_PYTHON=python
AEGIS_ENGINE_PATH=/absolute/path/to/AegisAI/engine
AEGIS_EXTENSION_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID/
