AEGIS_DEPLOYMENT_MODE=docker
POSTGRES_DB=aegisai
POSTGRES_USER=aegisai
POSTGRES_PASSWORD=generate-a-random-hex-secret
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://aegisai:generate-a-random-hex-secret@postgres:5432/aegisai?sslmode=disable

# Legacy shared endpoint token. New endpoints should enroll with one-time pairing codes.
AEGIS_AGENT_TOKEN=generate-a-random-agent-token
AEGIS_ADMIN_TOKEN=generate-a-random-admin-token

# Dashboard login and network settings.
AEGIS_DASHBOARD_USER=admin
AEGIS_DASHBOARD_PASSWORD=generate-a-long-random-dashboard-password
AEGIS_DASHBOARD_PORT=3000
AEGIS_DASHBOARD_BIND=127.0.0.1
HOSTNAME=0.0.0.0
PORT=3000

# The Control Plane is published on loopback only for a host HTTPS reverse proxy.
AEGIS_CONTROL_PLANE_PORT=8787
AEGIS_CONTROL_PLANE_BIND=127.0.0.1

# Runtime.
AEGIS_LISTEN_ADDR=127.0.0.1:8787
AEGIS_API_URL=http://127.0.0.1:8787
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
